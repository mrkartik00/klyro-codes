{
  "id": "KlyroH3Send00001",
  "name": "H3 — Scheduled send (claim → Gmail → result)",
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "saveDataSuccessExecution": "none"
  },
  "nodes": [
    {
      "id": "s",
      "name": "Every 5 min",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 5
            }
          ]
        }
      }
    },
    {
      "id": "ask-for-ready-sends",
      "name": "Ask for ready sends",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "jsCode": "return [{ json: { method: 'GET', path: `/internal/sends/ready?workspaceId=${$env.KLYRO_WORKSPACE_ID}&limit=5` } }];"
      }
    },
    {
      "id": "get-ready-sends",
      "name": "Get ready sends",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.1,
      "position": [
        440,
        0
      ],
      "parameters": {
        "source": "database",
        "workflowId": {
          "__rl": true,
          "value": "KlyroApiSigner01",
          "mode": "id"
        },
        "options": {}
      }
    },
    {
      "id": "one-claim-per-step",
      "name": "One claim per step",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "jsCode": "const rows = $input.first().json?.data || [];\nreturn rows.map((r) => ({ json: { method: 'POST', path: '/internal/sends/claim',\n  body: { workspaceId: $env.KLYRO_WORKSPACE_ID, enrollmentId: r.enrollmentId, stepOrder: r.stepOrder } } }));"
      }
    },
    {
      "id": "loop",
      "name": "One at a time",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        880,
        0
      ],
      "parameters": {
        "batchSize": 1,
        "options": {}
      }
    },
    {
      "id": "claim-send-slot",
      "name": "Claim send slot",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.1,
      "position": [
        1100,
        100
      ],
      "parameters": {
        "source": "database",
        "workflowId": {
          "__rl": true,
          "value": "KlyroApiSigner01",
          "mode": "id"
        },
        "options": {}
      }
    },
    {
      "id": "claimed-with-content",
      "name": "Claimed with content?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1320,
        100
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.data?.claimed === true && !$json.data?.idempotent && !!$json.data?.subject && !!$json.data?.body }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "build-email",
      "name": "Build email",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1540,
        0
      ],
      "parameters": {
        "jsCode": "// Plain-text body → simple HTML + mandatory one-click unsubscribe footer.\nconst c = $input.first().json.data;\nconst esc = (s) => String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst html = esc(c.body).split(/\\n{2,}/).map((p) => `<p>${p.replace(/\\n/g, '<br>')}</p>`).join('\\n')\n  + `\\n<p style=\"font-size:12px;color:#888\">Not interested? <a href=\"${c.unsubscribeUrl}\">Unsubscribe</a></p>`;\nreturn [{ json: { ...c, html } }];"
      }
    },
    {
      "id": "jit",
      "name": "Jitter 60-180s",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        1760,
        0
      ],
      "webhookId": "klyro-h3-jitter",
      "parameters": {
        "amount": "={{ 60 + Math.floor(Math.random() * 120) }}",
        "unit": "seconds"
      }
    },
    {
      "id": "gm",
      "name": "Gmail: send",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        1980,
        0
      ],
      "credentials": {
        "gmailOAuth2": {
          "id": "dPpp8UaFOG2tb53Q",
          "name": "Gmail — admin@klyro.codes"
        }
      },
      "onError": "continueErrorOutput",
      "parameters": {
        "resource": "message",
        "operation": "send",
        "sendTo": "={{ $('Build email').first().json.to }}",
        "subject": "={{ $('Build email').first().json.subject }}",
        "emailType": "html",
        "message": "={{ $('Build email').first().json.html }}",
        "options": {
          "appendAttribution": false,
          "senderName": "Kartik from Klyro",
          "customHeaders": {
            "values": [
              {
                "name": "X-Klyro-Msg",
                "value": "={{ $('Build email').first().json.headerToken }}"
              },
              {
                "name": "List-Unsubscribe",
                "value": "=<{{ $('Build email').first().json.unsubscribeUrl }}>"
              },
              {
                "name": "List-Unsubscribe-Post",
                "value": "List-Unsubscribe=One-Click"
              }
            ]
          }
        }
      }
    },
    {
      "id": "result:-sent",
      "name": "Result: sent",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2200,
        -80
      ],
      "parameters": {
        "jsCode": "const c = $('Build email').first().json; const s = $input.first().json;\nreturn [{ json: { method: 'POST', path: '/internal/sends/result', idempotencyKey: `sent-${c.messageId}`,\n  body: { workspaceId: $env.KLYRO_WORKSPACE_ID, messageId: String(c.messageId), ok: true, providerMessageId: s.id, threadId: s.threadId } } }];"
      }
    },
    {
      "id": "result:-failed",
      "name": "Result: failed",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2200,
        80
      ],
      "parameters": {
        "jsCode": "const c = $('Build email').first().json; const e = $input.first().json;\nreturn [{ json: { method: 'POST', path: '/internal/sends/result', idempotencyKey: `fail-${c.messageId}`,\n  body: { workspaceId: $env.KLYRO_WORKSPACE_ID, messageId: String(c.messageId), ok: false, error: String(e.error?.message || e.error || 'Gmail send failed').slice(0, 400) } } }];"
      }
    },
    {
      "id": "report-result",
      "name": "Report result",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.1,
      "position": [
        2420,
        0
      ],
      "parameters": {
        "source": "database",
        "workflowId": {
          "__rl": true,
          "value": "KlyroApiSigner01",
          "mode": "id"
        },
        "options": {}
      }
    }
  ],
