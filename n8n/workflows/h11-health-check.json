{
  "name": "H11 — Health check → Telegram",
  "meta": { "description": "Every 10 minutes, pings the Klyro API /health and alerts Telegram if it is not 200. Set TELEGRAM_BOT_TOKEN + TELEGRAM_CHAT_ID env vars and KLYRO_API_BASE." },
  "nodes": [
    {
      "parameters": { "rule": { "interval": [{ "field": "minutes", "minutesInterval": 10 }] } },
      "id": "cron",
      "name": "Every 10 min",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "url": "={{ $env.KLYRO_API_BASE }}/health",
        "options": { "response": { "response": { "fullResponse": true, "neverError": true } } }
      },
      "id": "ping",
      "name": "Ping /health",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [220, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true },
          "conditions": [
            { "leftValue": "={{ $json.statusCode }}", "rightValue": 200, "operator": { "type": "number", "operation": "notEquals" } }
          ]
        }
      },
      "id": "ifDown",
      "name": "Unhealthy?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [440, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.telegram.org/bot{{ $env.TELEGRAM_BOT_TOKEN }}/sendMessage",
        "sendBody": true,
        "contentType": "json",
        "jsonBody": "={{ JSON.stringify({ chat_id: $env.TELEGRAM_CHAT_ID, text: '⚠️ Klyro API health check failed (status ' + $json.statusCode + ')' }) }}",
        "options": {}
      },
      "id": "alert",
      "name": "Telegram alert",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [660, 0]
    }
  ],
  "connections": {
    "Every 10 min": { "main": [[{ "node": "Ping /health", "type": "main", "index": 0 }]] },
    "Ping /health": { "main": [[{ "node": "Unhealthy?", "type": "main", "index": 0 }]] },
    "Unhealthy?": { "main": [[{ "node": "Telegram alert", "type": "main", "index": 0 }], []] }
  },
  "settings": {}
}
